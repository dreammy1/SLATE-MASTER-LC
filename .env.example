# ─────────────────────────────────────────────────────────────────────────────
# SLATE DevOps OS — Master Dashboard · environment variable reference
# Copy to: .env.local      →   cp .env.example .env.local
#
# Free hosting (no Oracle):  see deploy/FREE-HOSTING-GUIDE.md
#   Render + Upstash  →  STORAGE_DRIVER=kv  +  KV_REST_API_URL/TOKEN
#   Own PC + Cloudflare Tunnel → STORAGE_DRIVER=file (default)
#   VPS / cPanel / Docker      → STORAGE_DRIVER=file (default)
# ─────────────────────────────────────────────────────────────────────────────


# ══ Storage ════════════════════════════════════════

# Where the single JSON document lives.
#   "file" → a JSON file on disk (VPS, cPanel, Docker volume). DEFAULT.
#   "kv"   → a hosted key/value store over HTTPS (Upstash Redis / Vercel KV).
# Use "kv" on any host whose disk is wiped on redeploy (Render, Koyeb, Fly).
# Leaving this unset auto-detects: KV if the credentials below are present,
# otherwise a local file. Setting "kv" WITHOUT credentials fails loudly on
# purpose, so a misconfigured deploy cannot silently lose data.
STORAGE_DRIVER=file

# Upstash Redis / Vercel KV REST credentials. Required when STORAGE_DRIVER=kv.
# Upstash console → your database → REST API → UPSTASH_REDIS_REST_URL / _TOKEN
# (Vercel's KV integration injects these with the KV_* names.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional override for which key holds the document (default: slate:db).
# APP_DATA_KEY=slate:db

# Where the JSON file is written when STORAGE_DRIVER=file.
# Mount a persistent volume and point this at it on hosts that wipe the
# working directory; on a VPS/cPanel the default ./data is correct.
# APP_DATA_DIR=/var/data

# Set to "true" to serve a read-only dashboard: browsing and login work, but
# every write is discarded (logged once). Useful for a demo or a broken store.
# SLATE_READONLY=false


# ══ Required ═══════════════════════════════════════════════════════════════

# 🔒 Secret key used to encrypt database passwords, handshake tokens and
#    webhook secrets stored in data/db.json.
#    ⚠️  NEVER change this after deploying sites — rotating it makes every
#        existing site unreachable.
#    Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ENCRYPTION_SECRET=

# Username for the admin panel (/admin/login)
ADMIN_USERNAME=masterops

# Password for the admin panel. Use a strong random value.
ADMIN_PASSWORD=

# The URL clients' browsers will reach. Must be the server's public IP or
# domain, otherwise clients get "Failed to fetch".
#   IP:      http://144.24.24.24
#   Domain:  https://master.yourdomain.com
#   Render:  https://slate-master.onrender.com
# Or let Master detect it from these Render/Codespaces-style vars:
#   RENDER_EXTERNAL_URL / VERCEL_URL / FLY_APP_NAME / K_SERVICE
MASTER_PUBLIC_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN

# Same value as MASTER_PUBLIC_URL — used by Next.js for absolute URLs.
NEXT_PUBLIC_APP_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN


# ══ Optional — security ═════════════════════════════════════════════════════

# Secret used to sign JWT session cookies. Falls back to ENCRYPTION_SECRET.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Runtime binding. Keep 127.0.0.1 so nginx is the only public entry point.
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1


# ══ Optional — integrations ═════════════════════════════════════════════════

# Default GitHub Personal Access Token, used when a new site is scaffolded.
# Can also be set per-site from the UI, so this is optional.
GITHUB_DEFAULT_PAT=

# Stripe (for paid orders / licence purchases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (for licence key emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_LICENSE=
SMTP_ENCRYPTION=tls


# ══ Optional — self-test ════════════════════════════════════════════════════
# Base URL used by `npm run selftest` when run from your own machine.
# E2E_BASE_URL=https://master.yourdomain.com
